# .env.example — Fluxoly Platform
#
# Copie para `.env` e ajuste os valores para desenvolvimento local. Em produção
# (Render), essas variáveis são definidas em Environment > Add Environment Variable,
# nunca commitadas. Nenhum valor real de produção deve aparecer aqui — apenas
# placeholders seguros para dev (ver ENGINEERING_GUIDE.md seção 3, "Variáveis
# de ambiente").

# ── Segredos (nunca usar o default em produção) ─────────────────────────────

# Chave usada para assinar o cookie de sessão do Flask. Default inseguro,
# só serve para dev local — gerar uma chave forte e única por ambiente em
# produção (ex.: `python -c "import secrets; print(secrets.token_hex(32))"`).
FLASK_SECRET_KEY=change-me

# ── Diretório de dados (banco, backups, tabela de preços) ───────────────────

# Diretório persistente onde `database.db`, backups e `data/price_tables.json`
# são armazenados. Em produção normalmente aponta para um volume montado.
# Se ausente, cai em FLY_DATA_DIR, depois RENDER_DISK_PATH, depois o próprio
# diretório da aplicação (dev local).
IR_FLOW_DATA_DIR=

# ── Rede e host ──────────────────────────────────────────────────────────────

# Host/porta do servidor Flask embutido (não usado atrás do Gunicorn em
# produção). Default: 0.0.0.0 em ambiente de servidor, 127.0.0.1 em dev local.
IR_FLOW_HOST=127.0.0.1
IR_FLOW_PORT=5080

# URL pública completa da aplicação (usada para montar links absolutos, ex.:
# checklist público). Deixe vazio em dev local.
IR_FLOW_PUBLIC_BASE_URL=

# Origens permitidas por CORS, separadas por vírgula. Nunca usar `*` em
# produção (ver SECURITY.md).
IR_FLOW_CORS_ORIGINS=http://localhost:5173

# Desativa a abertura automática do navegador ao iniciar o servidor local
# (qualquer valor não vazio desativa).
IR_FLOW_NO_BROWSER=

# ── Segurança (Sprint 3) ─────────────────────────────────────────────────────

# Timeout de sessão por inatividade, em minutos. Janela deslizante — cada
# request autenticado reseta o timer (ver SECURITY.md seção 1).
IR_FLOW_SESSION_INACTIVITY_MINUTES=30

# Validade do token de recuperação de senha gerado pelo admin, em horas
# (ver SECURITY.md seção 7).
IR_FLOW_PASSWORD_RESET_TOKEN_HOURS=24

# ── Backup automático ────────────────────────────────────────────────────────

# Habilita/desabilita jobs em background (backup automático, sync MercadoPhone).
# Testes definem "0" via conftest.py — nunca alterar isso manualmente em testes.
IR_FLOW_ENABLE_BACKGROUND_JOBS=1

# Diretório local de destino do backup no Google Drive (quando montado via
# rclone ou similar). Deixe vazio para desativar.
IR_FLOW_GOOGLE_DRIVE_BACKUP_DIR=

# Credenciais de e-mail para envio automático de backup (Gmail com senha de
# app, não a senha da conta). Deixe a senha vazia para desativar o envio.
IR_FLOW_BACKUP_EMAIL=ir.phones.flow@gmail.com
IR_FLOW_BACKUP_EMAIL_SENHA=
IR_FLOW_BACKUP_EMAIL_DESTINO=ir.phones.flow@gmail.com

# ── Timeouts internos ────────────────────────────────────────────────────────

# Timeout de conexão SQLite em segundos (mínimo aplicado: 5).
IR_FLOW_SQLITE_TIMEOUT_SECONDS=30

# ── Integração MercadoPhone ──────────────────────────────────────────────────

# Token esperado no header do webhook de importação de OS. Obrigatório para o
# webhook funcionar: sem valor configurado, toda requisição é rejeitada com
# 401 (fail secure) — não existe mais modo "sem validação" em dev local.
MERCADO_PHONE_WEBHOOK_TOKEN=

# Token usado para autenticar chamadas à API do MercadoPhone.
MERCADO_PHONE_API_TOKEN=

# Técnico padrão atribuído a OS importadas sem técnico definido.
MERCADO_PHONE_DEFAULT_TECNICO=Aguardando definicao

# Habilita a sincronização periódica em background ("1"/"0"). Testes definem
# "0" via conftest.py.
MERCADO_PHONE_SYNC_ENABLED=1
MERCADO_PHONE_SYNC_INTERVAL_SECONDS=30
MERCADO_PHONE_SYNC_TIMEOUT_SECONDS=20

# Se "1", só sincroniza depois do primeiro boot completo (evita concorrência
# com a migração de schema na inicialização).
MERCADO_PHONE_SYNC_ONLY_AFTER_BOOT=0

# Data a partir da qual OS importadas do MercadoPhone são consideradas
# (formato YYYY-MM-DD) — OS mais antigas ficam ocultas da listagem, não
# excluídas do banco.
MERCADO_PHONE_SYNC_START_DATE=2026-04-01

# ── Observabilidade (Sprint Observabilidade, 2026-07-25) ────────────────────

# DSN do Sentry para captura de erro em produção. Vazio desabilita a
# integração por completo (nenhuma chamada de rede, nenhum overhead) --
# comportamento padrão até a conta Sentry existir.
SENTRY_DSN=

# Token exigido no header X-Metrics-Token para consultar /metrics fora de
# dev local (IS_SERVER_RUNTIME=True). Sem essa variável configurada em
# produção, o endpoint nega por padrão em vez de ficar aberto.
METRICS_TOKEN=

# ── Variáveis injetadas automaticamente pela plataforma de deploy ───────────
# Não definir manualmente em dev local — documentadas aqui só para explicar
# a detecção de ambiente de servidor (IS_SERVER_RUNTIME em app.py).

# FLY_DATA_DIR=              # injetado pelo Fly.io (volume persistente)
# RENDER=                    # injetado pelo Render.com
# RENDER_DISK_PATH=          # injetado pelo Render.com (disco persistente)
# RENDER_SERVICE_ID=         # injetado pelo Render.com
# VERCEL_URL=                # injetado pela Vercel, se usado para preview do frontend
# PROMETHEUS_MULTIPROC_DIR=  # setada via ENV no Dockerfile (métricas multiprocess)
# LOCALAPPDATA=              # variável de ambiente do Windows (build desktop PyInstaller)
