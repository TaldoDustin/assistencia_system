# Ferramenta interna "Lista de Aparelhos Disponíveis" — variáveis de ambiente.
# TODAS entram como env var no projeto Vercel `estoque-fluxoly`. NENHUMA vai para o repositório.
# Ver docs/engineering/adr/ADR-013.md ("Regra explícita de isolamento de credencial").

# Token da API nova do MercadoPhone (platform.mercadophone.tech, header X-API-Key).
# ROTACIONAR no MercadoPhone após o primeiro deploy (foi exposto em texto puro no chat de Discovery).
MERCADOPHONE_API_KEY=

# Senhas das duas áreas. Precisam ser diferentes entre si. O CTO define no provisionamento.
SENHA_GERAL=
SENHA_ESTOQUE=

# Segredo para assinar o cookie de sessão (string longa aleatória).
COOKIE_SIGNING_SECRET=

# Segredo para acionar /api/sync manualmente (operador / GitHub Actions de fallback).
SYNC_SECRET=

# Injetado automaticamente pelo Vercel Cron — não precisa preencher à mão se usar cron nativo.
# CRON_SECRET=

# Injetados automaticamente ao vincular o Vercel KV ao projeto:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
